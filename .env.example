# DataStream AI Configuration Environment Variables

# App Settings
APP_ENV=development
APP_PORT=8501
LOG_LEVEL=INFO

# PostgreSQL Connection (Optional: will gracefully fallback to SQLite if offline)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=datastream_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MongoDB Connection (Optional: will gracefully fallback to local JSON event store if offline)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DATABASE=datastream_events

# Kafka Connection (Optional: will gracefully fallback to built-in event streaming simulator if offline)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=user-events

# Gemini LLM / AI API (Optional: provides smart RAG answer generation, falls back to local TF-IDF & deterministic SQL responder)
GEMINI_API_KEY=your_gemini_api_key_here
